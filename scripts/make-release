#!/bin/sh

set -eu

if [ ! -f CHANGELOG.md ]; then
    echo "This script must be executed from the project root directory" >&2
    exit 1
fi

if ! git diff-index --quiet HEAD; then
    echo "Git index is not clean" >&2
    exit 1
fi

today=$(date -I)

# If the year changed since last release, we reset the digit to 0, otherwise we
# simply increment it
cur_year=$(date '+%Y')
prv_prj_year=$(cut -f1 -d. VERSION)
if [ "$prv_prj_year" -ne "$cur_year" ]; then
    new_digit=0
else
    prv_prj_digit=$(cut -f2 -d. VERSION)
    new_digit=$((prv_prj_digit+1))
fi

# Project version bump
prv_prj_ver=$(cat VERSION)
new_prj_ver="${cur_year}.${new_digit}"
echo "New project version: $prv_prj_ver → $new_prj_ver"

# Library version bumps
get_lib_version() {
    printf "Enter new %s version [current: %s]: " "$1" "$(cat "$1/VERSION")" >&2
    read -r ver
    if ! echo "$ver" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+$'; then
        echo "Invalid $1 version: \"$ver\"" >&2
        exit 1
    fi
    echo "$ver"
}
new_nopegl_ver=$(get_lib_version libnopegl)
new_nopemedia_ver=$(get_lib_version libnopemedia)
new_nopegpu_ver=$(get_lib_version libnopegpu)

# Execute the version bump: we are verbose with set -x to be transparent about
# the actions that matters
set -x
echo "$new_prj_ver" > VERSION
echo "$new_nopegl_ver" > libnopegl/VERSION
echo "$new_nopemedia_ver" > libnopemedia/VERSION
echo "$new_nopegpu_ver" > libnopegpu/VERSION
sed "/^## \[Unreleased\]/a \\\n## [$new_prj_ver / libnopegl $new_nopegl_ver / libnopemedia $new_nopemedia_ver / libnopegpu $new_nopegpu_ver][$new_prj_ver] - $today" -i CHANGELOG.md
echo "[$new_prj_ver]: https://github.com/NopeForge/nope.gl/releases/tag/v$new_prj_ver" >> CHANGELOG.md
git add CHANGELOG.md VERSION libnopegl/VERSION libnopemedia/VERSION libnopegpu/VERSION
git commit -m "Release $new_prj_ver"
git tag "v${new_prj_ver}"
